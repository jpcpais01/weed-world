; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Weed World"
config/description="A cozy co-op magical forest adventure starring the Kelings."
config/version="0.1.0"
run/main_scene="res://ui/loading/loading_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.035, 0.07, 0.045, 1)
boot_splash/image="res://branding/splash.png"
boot_splash/stretch_mode=4
config/icon="res://branding/icon.png"
config/windows_native_icon="res://branding/icon.ico"
config/quit_on_go_back=false

[autoload]

GameInput="*res://autoload/game_input.gd"
Settings="*res://autoload/settings.gd"
Updater="*res://autoload/updater.gd"
Net="*res://autoload/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1

[shader_globals]

ground_height={
"type": "sampler2D",
"value": ""
}
ground_mask={
"type": "sampler2D",
"value": ""
}
ground_detail={
"type": "sampler2D",
"value": ""
}
ground_grid={
"type": "vec4",
"value": Vector4(-60, -60, 0.5, 241)
}
ground_blend={
"type": "float",
"value": 0.0
}
